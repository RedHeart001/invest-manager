# ---- 基础 ----
DATABASE_URL="file:./dev.db"
DATA_SERVICE_URL=http://localhost:8000

# ---- LLM（OpenAI 兼容端点；DeepSeek/GLM 可按模型名自动推断 base_url） ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 搜索（P3 热点 pipeline；TAVILY_API_KEY 与 SEARCH_API_KEY 互为别名） ----
TAVILY_API_KEY=

# ---- P6 扩展机制 ----
SKILLS_DIR=./skills            # 技能目录（默认 ./skills，相对 web 根）
# SKILL_ROUTER=llm             # 技能路由模式：llm=主 LLM 经 load_skill 工具按需加载（默认）/
                               # keyword=触发词子串匹配注入（原行为）/ hybrid=关键词照注 + 工具补长尾
MCP_CONFIG=./mcp.json          # 第三方 MCP server 白名单（可为空文件）
# SKILL_MAX_BODY_CHARS=2400    # 技能正文注入上限（字符）
# SKILL_MAX_ACTIVE=3           # 单轮同时激活技能数上限
# MCP_TIMEOUT_MS=20000         # MCP 握手/调用超时
# MCP_PROBE_TIMEOUT_S=5        # 状态面板探测的等待上限（秒）：只限时返回、不据此判降级
# MCP_RETRY_COOLDOWN_MS=60000  # MCP 连接失败后的重试冷却（防 spawn 风暴）

# ---- ingest 回调共享密钥（P3 起支持；P7 容器化时强制） ----
# ⚠ 留空 = **fail-open**：`api/hotspots/ingest/route.ts` 的判据是
#    `if (expected && header !== expected)`，即 expected 未设时任何 POST 都能落库
#    （无 Origin 的 curl/脚本本来也放行）。单机开发可接受；只要 WEB_PORT 有暴露面
#    就必须设值（完整身份鉴权仍属 G7，未闭环）。
INGEST_TOKEN=

# ---- 跨站来源白名单（写接口 CSRF 纵深防御，lib/request-origin.ts:29） ----
# 逗号分隔的 host，如 "127.0.0.1:3000,192.168.1.10:3000"。
# 同源请求靠"Origin host == 请求 Host"放行，本键只用于**反代/改端口/局域网访问**
# 那些 host 不相等的合法场景；不设 = 只允许同源（更严，默认即可）。
ALLOWED_ORIGINS=

# ---- 海外数据源代理（R12：只有 data-service 侧读它，web 进程不消费此键） ----
# ⚠️ 生效路径有两条（**09-27 20:5x A7 探针更正本块原写法**——原文"不加载任何 .env"不成立）：
#    data-service 不读**根目录** .env，但 `app/config.py:17-20` 的 `_ENV_FILES` 含
#    `data-service/.env` 与 `../web/.env` 两份，`load_env()` 在 import 期以 `setdefault`
#    灌进 `os.environ`（探针：`import app.main` 后 web/.env 的 7 个键出现在进程环境里；
#    再把 `_ENV_FILES` 指向含 `HTTPS_PROXY=…` 的临时文件 ⇒ `crypto_provider._proxies()` 读到它）。
#    为什么必须显式设置：`app/main.py` 的 `NO_PROXY=*`（保护东财/新浪直连）会连带屏蔽系统注册表代理
#    ⇒ 两处都不设时 CoinGecko 不可达、加密主数据 0 行（2026-09-27 实测，FIX-LEDGER CR9-41）。
#    本机 dev 两种写法（**端到端只实测过 ①**，② 是机制成立、端到端待验）：
#      ① 与命令同行：`HTTPS_PROXY=http://127.0.0.1:<代理端口> … uvicorn app.main:app`
#      ② 直接填本键（web/.env 里给真值，或建 data-service/.env）
#    容器侧无需处理：根 `.env` → docker-compose 已透传（见根 `.env.example`）。
HTTPS_PROXY=

# ---- data-service 侧（仅跑 app.mcp_server --http 或 search 回调时需要） ----
# WEB_API_BASE=http://localhost:3000   # MCP search_products 回调 web BFF 的地址
# US_LIST_PAGES=15               # 美股名单每次翻几页（CR9-59／#32 甲）：新浪把 num 硬截到 20 行/页
#                                 # ⇒ 页数＝请求数，15 页≈300 只前排标的；代码里另有一道
#                                 # US_LIST_PAGE_CEILING=50 的硬上限，防"手滑多打两个 0"变成几千次上游请求。
#                                 # 全量盘子是 18,241 只＝913 次请求（那是「乙」，主人未拍，别自己调大）。
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8765

# ---- 10-18 补：25 枚「代码真读、模板此前没有条目」的启动期旋钮（追加九十二 刀 F′） ----
# 为什么现在补齐：`docs/PLAN.md` 那句「完整模板见 web/.env.example（P6 已补全为全量清单）」
# 与实测不符＝同一把尺（`^\s*#?\s*KEY=` 才算条目；分子分母都由脚本逐根扫）量出来
# **码里读到 52 枚、本文件补前只有 20 枚有条目**，补后 45 枚。余下 7 枚＝测试脚手架
# （DS_URL／BASE／PY／SMOKE_TIMEOUT_MS／TEST_MCP_KEY）＋NODE_ENV＋SEARCH_API_KEY
# （后者模板里只写了"TAVILY_API_KEY 的别名"那句说明、没有独立条目）。
# 下面全部**保持注释态**：`load_env()` 用 setdefault 灌进程，写出空值会真的把变量设成空串
# ＝比不设更糟（默认值一律抄自代码里的常数，落码时逐枚核对过）。
# 落点类四枚（…_STATE_FILE／DB_PATH）平时**不需要设**：它们的存在是给离线单测指向临时目录
# （不指就会把 marker 写进仓库那份真文件＝闸自己变常绿），手工排查时才点名覆盖。
# SYNC_HOUR=2                    # 每日同步腿的时刻（时，默认 2＝02:00；app/sync_scheduler.py:55）
# SYNC_MINUTE=0                  # 同上（分）
# SYNC_CATCHUP=on                # 重启时是否补跑当日漏掉的那一轮；off＝只等每日 cron（本机现用 off）
# SYNC_STATE_FILE=               # 同步腿 marker 落点（默认 data-service/runtime/sync-state.json）
# HOTSPOT_STATE_FILE=            # 热点腿状态位落点（含 lastResult 与 lastAttemptDate）
# HOTSPOT_PIPELINE_TIMEOUT_S=300 # 一轮热点 pipeline 的总预算（秒）
# LIMITER_STATE_FILE=            # 令牌计数 durable 落点；**离线套件必须指临时目录**
# DB_PATH=                       # 备份要复制的那个 .db 绝对路径（默认按仓库布局推）
# BACKUP_DIR=                    # 备份落点目录
# BACKUP_HOUR=3                  # dbBackup 时刻（时，默认 03:30）
# BACKUP_MINUTE=30               # 同上（分）
# BACKUP_KEEP=7                  # 保留几份备份
# BACKUP_MAX_AGE_DAYS=30         # 超过这么多天没有成功备份 ⇒ 起服务时补跑一次
# BACKUP_STALE_HOURS=26          # 「错过一次 03:30 ＋ 2 小时容差」那把尺（只量备份，不量主数据）
# REALTIME_TTL_S=                # 留空＝用码内初值（现价 5s／分时 60s）；设 0＝整族关掉
# RESEARCH_MAX_COLLECT_THREADS=4 # 研报采集并发上限
# RESEARCH_COLLECT_ACQUIRE_TIMEOUT=60  # 采集侧取额度的等待上限（秒）
# RESEARCH_MAX_LLM_CALLS=12      # 单次研报的 LLM 调用预算
# RESEARCH_TASK_TIMEOUT_S=480    # 单任务总超时（秒）
# MCP_LIST_TIMEOUT_S=120         # MCP list_products 的内在超时（对照"卡死 4 分钟"那一形）
# WEB_BASE_URL=http://localhost:3000   # ds 回调 web 的基址（热点补跑问"今天有没有 digest"也读它）
# ⚠️ 上面这块不含 CHAT_CONTEXT_BUDGET／LLM_DEBUG——那两枚住 web 侧（lib/context-budget.ts、
#    lib/llm.ts），与本块的 data-service 侧不同读法，登记在 FIX-LEDGER 的同一枚待拍板里。
# （10-18 自纠：本句原想说"这两枚不在本块"，结果它自己把键名写进模板、让"模板覆盖率"这把尺
#   把它们读成已覆盖。既然要补就一起补，于是下面两行才是它们的真位置。）
# CHAT_CONTEXT_BUDGET=24000      # web 侧上下文字符预算（lib/context-budget.ts:8；非法值／未设＝用码内默认）
# LLM_DEBUG=                     # 设 1 才打印 LLM 请求细节（lib/llm.ts:171，B3＝默认静默）
# HTTP_PROXY=                    # 与 HTTPS_PROXY 同一条回退链里的国内档（hotspot/pipeline.py 读）
# REFRESH_PROGRESS_FILE=         # 刷新腿进度落点（web/lib/refresh-progress.ts；离线测试必须指临时目录）
