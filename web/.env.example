# ---- 基础 ----
DATABASE_URL="file:./dev.db"
DATA_SERVICE_URL=http://localhost:8000

# ---- LLM（OpenAI 兼容端点；DeepSeek/GLM 可按模型名自动推断 base_url） ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 搜索（P3 热点 pipeline；TAVILY_API_KEY 与 SEARCH_API_KEY 互为别名） ----
TAVILY_API_KEY=

# ---- P6 扩展机制 ----
SKILLS_DIR=./skills            # 技能目录（默认 ./skills，相对 web 根）
# SKILL_ROUTER=llm             # 技能路由模式：llm=主 LLM 经 load_skill 工具按需加载（默认）/
                               # keyword=触发词子串匹配注入（原行为）/ hybrid=关键词照注 + 工具补长尾
MCP_CONFIG=./mcp.json          # 第三方 MCP server 白名单（可为空文件）
# SKILL_MAX_BODY_CHARS=2400    # 技能正文注入上限（字符）
# SKILL_MAX_ACTIVE=3           # 单轮同时激活技能数上限
# MCP_TIMEOUT_MS=20000         # MCP 握手/调用超时
# MCP_PROBE_TIMEOUT_S=5        # 状态面板探测的等待上限（秒）：只限时返回、不据此判降级
# MCP_RETRY_COOLDOWN_MS=60000  # MCP 连接失败后的重试冷却（防 spawn 风暴）

# ---- ingest 回调共享密钥（P3 起支持；P7 容器化时强制） ----
# ⚠ 留空 = **fail-open**：`api/hotspots/ingest/route.ts` 的判据是
#    `if (expected && header !== expected)`，即 expected 未设时任何 POST 都能落库
#    （无 Origin 的 curl/脚本本来也放行）。单机开发可接受；只要 WEB_PORT 有暴露面
#    就必须设值（完整身份鉴权仍属 G7，未闭环）。
INGEST_TOKEN=

# ---- 跨站来源白名单（写接口 CSRF 纵深防御，lib/request-origin.ts:29） ----
# 逗号分隔的 host，如 "127.0.0.1:3000,192.168.1.10:3000"。
# 同源请求靠"Origin host == 请求 Host"放行，本键只用于**反代/改端口/局域网访问**
# 那些 host 不相等的合法场景；不设 = 只允许同源（更严，默认即可）。
ALLOWED_ORIGINS=

# ---- 海外数据源代理（R12：只有 data-service 侧读它，web 进程不消费此键） ----
# ⚠️ 生效路径有两条（**09-27 20:5x A7 探针更正本块原写法**——原文"不加载任何 .env"不成立）：
#    data-service 不读**根目录** .env，但 `app/config.py:17-20` 的 `_ENV_FILES` 含
#    `data-service/.env` 与 `../web/.env` 两份，`load_env()` 在 import 期以 `setdefault`
#    灌进 `os.environ`（探针：`import app.main` 后 web/.env 的 7 个键出现在进程环境里；
#    再把 `_ENV_FILES` 指向含 `HTTPS_PROXY=…` 的临时文件 ⇒ `crypto_provider._proxies()` 读到它）。
#    为什么必须显式设置：`app/main.py` 的 `NO_PROXY=*`（保护东财/新浪直连）会连带屏蔽系统注册表代理
#    ⇒ 两处都不设时 CoinGecko 不可达、加密主数据 0 行（2026-09-27 实测，FIX-LEDGER CR9-41）。
#    本机 dev 两种写法（**端到端只实测过 ①**，② 是机制成立、端到端待验）：
#      ① 与命令同行：`HTTPS_PROXY=http://127.0.0.1:<代理端口> … uvicorn app.main:app`
#      ② 直接填本键（web/.env 里给真值，或建 data-service/.env）
#    容器侧无需处理：根 `.env` → docker-compose 已透传（见根 `.env.example`）。
HTTPS_PROXY=

# ---- data-service 侧（仅跑 app.mcp_server --http 或 search 回调时需要） ----
# WEB_API_BASE=http://localhost:3000   # MCP search_products 回调 web BFF 的地址
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8765
