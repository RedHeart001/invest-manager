# 容器编排配置模板（P7）
#
#   cp .env.example .env    # 然后填入真实值；.env 已被 .gitignore 忽略
#
# 注意：compose 读取的是**本目录**的 .env（用于 ${VAR} 插值），
#      与 web/.env（Next.js 开发态配置）相互独立——容器内的 DATABASE_URL
#      等由 docker-compose.yml 的 environment 显式覆盖。

# ---- 必填：落库回调共享密钥（未设置时 compose 拒绝启动） ----
# 生成建议：openssl rand -hex 24
INGEST_TOKEN=

# ---- 对外端口（默认 3000） ----
WEB_PORT=3000

# ---- LLM（OpenAI 兼容端点） ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 搜索（P3 热点 pipeline） ----
TAVILY_API_KEY=

# ---- 代理透传（R12 海外源；容器内访问宿主机代理用 host.docker.internal） ----
# 示例：HTTPS_PROXY=http://host.docker.internal:7897
HTTP_PROXY=
HTTPS_PROXY=
# 必须包含服务名与回环地址，否则容器间调用会被代理拦截
NO_PROXY=localhost,127.0.0.1,web,data-service
