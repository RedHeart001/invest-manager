# 构建上下文排除清单
# 虚拟环境（隔离的 spike 环境尤其大，绝不进镜像）
.venv
.venv-spike
.venv-broken
.venv*

__pycache__
*.pyc
*.pyo

# 数据卷（P7 备份时需要只读挂载，但不打包进镜像）
data

# 日志与临时产物
*.log
spike_*
*_result*.txt
tests/_tmp*

# 测试目录（离线单测，运行镜像不需要；如需要可用 compose exec 挂载）
tests

# 容器化文件自身
Dockerfile
.dockerignore

# 版本控制与编辑器
.git
.gitignore
.gitattributes
.vscode
.idea
